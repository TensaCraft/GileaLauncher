{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GileaLauncher",
  "mainBinaryName": "GileaLauncher",
  "identifier": "com.gilealauncher",
  "build": {
    "frontendDist": "../launcher-ui/dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Minecraft launcher",
        "width": 1366,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "decorations": false,
        "theme": "Dark",
        "backgroundColor": "#0B1412",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost shot: http://shot.localhost data: https:; font-src 'self' data:; media-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "publisher": "GIGABAIT",
    "category": "Game",
    "shortDescription": "Minecraft launcher",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
